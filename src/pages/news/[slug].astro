---
/**
 * /news/[slug] — SSR article page (Ukrainian locale by default).
 *
 * export const prerender = false instructs Astro hybrid mode to render
 * this page on every request, fetching fresh data from the Go API.
 *
 * Caching: Cache-Control is forwarded as-is from the Go API response.
 * The node adapter / CDN (Cloudflare, etc.) will honour s-maxage.
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Footer } from "@/components/layout/Footer";
import { Header } from "@/components/layout/Header";
import { ArticlePage } from "@/routes/news/ArticlePage";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/i18n";
import { normalizeText, extractArticleSummary, getEffectiveSeoPreview } from "@/utils/seo";

// ─── Type definitions ─────────────────────────────────────────────────────────

interface NewsLocale {
  locale: string;
  title: string;
  slug: string;
  description: string;
  content: string;
  seo_title: string;
  seo_description: string;
}

interface NewsCategory {
  id: string;
  color: string;
  icon: string;
  cover_image: string;
  locales: Record<string, any>;
}

interface NewsArticle {
  id: string;
  status: "draft" | "published";
  category_id: string;
  category?: NewsCategory;
  tags: { id: string; slug: string; name: string }[];
  author: { name: string; avatar?: string; position?: string };
  image_url: string;
  video_url?: string;
  video_type?: "external" | "uploaded";
  gallery?: string[];
  cover_position?: string;
  is_pinned: boolean;
  publish_at?: string;
  published_at?: string;
  created_at: string;
  updated_at: string;
  locales: Record<string, NewsLocale>;
}

// ─── Server-side data fetch ────────────────────────────────────────────────────

const locale: Locale = "uk";
const t = getTranslations(locale);

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/news", 302);
}

import { getSsrApiBase } from "@/lib/api-config";

const API_BASE = getSsrApiBase();

let article: NewsArticle | null = null;

try {
  const res = await fetch(
    `${API_BASE}/api/v1/news/${encodeURIComponent(slug)}?locale=${locale}`,
    {
      headers: { Accept: "application/json" },
    }
  );

  if (res.status === 301 || res.status === 302) {
    const location = res.headers.get("Location");
    if (location) {
      const canonical = location.split("/").pop()?.split("?")[0];
      if (canonical && canonical !== slug) {
        return Astro.redirect(`/news/${canonical}`, 301);
      }
    }
  }

  if (res.status === 404) {
    return Astro.redirect("/news", 302);
  }

  if (!res.ok) {
    console.error(`[news/[slug]] API error: ${res.status} for slug=${slug}`);
    return Astro.redirect("/news", 302);
  }

  const cacheControl = res.headers.get("Cache-Control");
  if (cacheControl) {
    Astro.response.headers.set("Cache-Control", cacheControl);
  }

  article = (await res.json()) as NewsArticle;
} catch (err) {
  console.error("[news/[slug]] fetch failed:", err);
  return Astro.redirect("/news", 302);
}

if (!article) {
  return Astro.redirect("/news", 302);
}

// ─── Derived metadata ──────────────────────────────────────────────────────────

const localePart = article.locales?.[locale] ?? article.locales?.["uk"];
const preview = getEffectiveSeoPreview({
  title: localePart?.title ?? "",
  description: localePart?.description ?? "",
  content: localePart?.content ?? "",
  seoTitle: localePart?.seo_title ?? "",
  seoDescription: localePart?.seo_description ?? "",
  fallbackTitle: t.meta.newsTitle,
  fallbackDescription: t.meta.newsDescription,
});

const title = preview.effectiveTitle;
const description = preview.effectiveDescription;

const siteUrl =
  Astro.site?.toString()?.replace(/\/$/, "") ?? Astro.url.origin;
const canonicalSlug = localePart?.slug ?? slug;
if (canonicalSlug && canonicalSlug !== slug) {
  return Astro.redirect(`/news/${canonicalSlug}`, 301);
}
const articleUrl = `${siteUrl}/news/${canonicalSlug}/`;

const publishedAt = article.published_at
  ? new Date(article.published_at).toISOString()
  : undefined;
const modifiedAt = new Date(article.updated_at).toISOString();

// JSON-LD schema for NewsArticle
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: localePart?.title,
  description: localePart?.description,
  datePublished: publishedAt,
  dateModified: modifiedAt,
  url: articleUrl,
  image: article.image_url
    ? [
        `${article.image_url}-640w.webp`,
        `${article.image_url}-1024w.webp`,
      ]
    : undefined,
  author: article.author?.name
    ? {
        "@type": "Person",
        name: article.author.name,
        jobTitle: article.author.position,
      }
    : undefined,
  publisher: {
    "@type": "Organization",
    name: t.meta.siteName,
    url: siteUrl,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};
import { hasEnglishTranslation } from "@/lib/news-api";

const hasEng = hasEnglishTranslation(article);
---

<Layout
  title={`${title} | ${t.meta.siteName}`}
  description={description}
  ogType="article"
  jsonLdExtra={articleJsonLd}
  locale={locale}
>
  <div class="overflow-x-clip w-full min-h-screen flex justify-center bg-slate-50 text-slate-900">
    <div class="flex w-full relative flex-col items-start min-h-screen">
      <Header
        client:load
        variant="light"
        headerPosition="absolute"
        locale={locale}
        currentPath={Astro.url.pathname}
        hasEnglishTranslation={hasEng}
      />
      <main id="main-content" class="w-full bg-slate-50 text-slate-900">
        <ArticlePage client:visible article={article} locale={locale} />
        <Footer client:visible locale={locale} />
      </main>
    </div>
  </div>
</Layout>
