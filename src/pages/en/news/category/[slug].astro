---
/**
 * /en/news/category/[slug] — SSR news category listing page (English locale).
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Footer } from "@/components/layout/Footer";
import { Header } from "@/components/layout/Header";
import { NewsPage } from "@/routes/news/NewsPage";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/i18n";

const locale: Locale = "en";
const t = getTranslations(locale);

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/en/news", 302);
}

const API_BASE =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";

let initialArticles: unknown[] = [];
let initialTotal = 0;
let initialCategories: unknown[] = [];
let targetCategoryId = "";
let pageTitle = t.meta.newsTitle;
let pageDesc = t.meta.newsDescription;

try {
  // Fetch all categories to find the ID for this slug
  const categoriesRes = await fetch(`${API_BASE}/api/v1/news/categories`, {
    headers: { Accept: "application/json" },
  });

  if (categoriesRes.ok) {
    const cats = await categoriesRes.json();
    initialCategories = Array.isArray(cats) ? cats : [];
    
    // Find category by slug
    const cat = initialCategories.find((c: any) => 
      c.locales?.[locale]?.slug === slug || c.slug === slug
    ) as any;

    if (cat) {
      targetCategoryId = cat.id;
      if (cat.locales?.[locale]) {
        pageTitle = cat.locales[locale].seo_title || `${cat.locales[locale].name} | ${t.meta.newsTitle}`;
        pageDesc = cat.locales[locale].seo_description || cat.locales[locale].description || pageDesc;
      }
      
      // Fetch articles for this category
      const articlesRes = await fetch(
        `${API_BASE}/api/v1/news?locale=${locale}&status=published&category=${targetCategoryId}&limit=12`,
        { headers: { Accept: "application/json" } }
      );
      
      if (articlesRes.ok) {
        const data = (await articlesRes.json()) as {
          articles: unknown[];
          total: number;
        };
        initialArticles = data.articles ?? [];
        initialTotal = data.total ?? 0;
        
        const cc = articlesRes.headers.get("Cache-Control");
        if (cc) Astro.response.headers.set("Cache-Control", cc);
      }
    } else {
      return Astro.redirect("/en/news", 302);
    }
  }
} catch (err) {
  console.error("[en/news/category] SSR fetch failed:", err);
}
---

<Layout
  title={pageTitle}
  description={pageDesc}
  locale={locale}
>
  <div class="overflow-x-clip w-full min-h-screen flex justify-center bg-pure-white">
    <div class="flex w-full relative flex-col items-start min-h-screen">
      <Header
        client:load
        variant="light"
        headerPosition="absolute"
        locale={locale}
        currentPath={Astro.url.pathname}
      />
      <main id="main-content" class="w-full">
        <NewsPage
          client:visible
          locale={locale}
          initialArticles={initialArticles}
          initialTotal={initialTotal}
          initialCategories={initialCategories}
          initialCategoryId={targetCategoryId}
        />
      </main>
      <Footer client:visible locale={locale} />
    </div>
  </div>
</Layout>
