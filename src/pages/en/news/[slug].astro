---
/**
 * /en/news/[slug] — SSR article page (English locale).
 *
 * Mirrors /news/[slug].astro but uses locale="en".
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Footer } from "@/components/layout/Footer";
import { Header } from "@/components/layout/Header";
import { normalizeText, extractArticleSummary, getEffectiveSeoPreview } from "@/utils/seo";
import { ArticlePage } from "@/routes/news/ArticlePage";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/i18n";

interface NewsLocale {
  locale: string;
  title: string;
  slug: string;
  description: string;
  content: string;
  seo_title: string;
  seo_description: string;
}

interface NewsCategory {
  id: string;
  color: string;
  icon: string;
  cover_image: string;
  locales: Record<string, any>;
}

interface NewsArticle {
  id: string;
  status: "draft" | "published";
  category_id: string;
  category?: NewsCategory;
  tags: { id: string; slug: string; name: string }[];
  author: { name: string; avatar?: string; position?: string };
  image_url: string;
  is_pinned: boolean;
  publish_at?: string;
  published_at?: string;
  created_at: string;
  updated_at: string;
  locales: Record<string, NewsLocale>;
}

const locale: Locale = "en";
const t = getTranslations(locale);

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/en/news", 302);
}

import { getSsrApiBase } from "@/lib/api-config";

const API_BASE = getSsrApiBase();

let article: NewsArticle | null = null;

try {
  const res = await fetch(
    `${API_BASE}/api/v1/news/${encodeURIComponent(slug)}?locale=${locale}`,
    { headers: { Accept: "application/json" } }
  );

  if (res.status === 301 || res.status === 302) {
    const location = res.headers.get("Location");
    if (location) {
      const canonical = location.split("/").pop()?.split("?")[0];
      if (canonical && canonical !== slug) {
        return Astro.redirect(`/en/news/${canonical}`, 301);
      }
    }
  }

  if (res.status === 404) {
    return Astro.redirect("/en/news", 302);
  }

  if (!res.ok) {
    console.error(`[en/news/[slug]] API error: ${res.status} for slug=${slug}`);
    return Astro.redirect("/en/news", 302);
  }

  const cacheControl = res.headers.get("Cache-Control");
  if (cacheControl) {
    Astro.response.headers.set("Cache-Control", cacheControl);
  }

  article = (await res.json()) as NewsArticle;
} catch (err) {
  console.error("[en/news/[slug]] fetch failed:", err);
  return Astro.redirect("/en/news", 302);
}

import { hasEnglishTranslation } from "@/lib/news-api";

if (!hasEnglishTranslation(article)) {
  const ukSlug = article.locales?.["uk"]?.slug || article.id;
  return Astro.redirect(`/news/${encodeURIComponent(ukSlug)}?untranslated=1`, 302);
}

const localePart = article.locales?.[locale] ?? article.locales?.["uk"];
const preview = getEffectiveSeoPreview({
  title: localePart?.title ?? "",
  description: localePart?.description ?? "",
  content: localePart?.content ?? "",
  seoTitle: localePart?.seo_title ?? "",
  seoDescription: localePart?.seo_description ?? "",
  fallbackTitle: t.meta.newsTitle,
  fallbackDescription: t.meta.newsDescription,
});

const title = preview.effectiveTitle;
const description = preview.effectiveDescription;

const siteUrl =
  Astro.site?.toString()?.replace(/\/$/, "") ?? Astro.url.origin;
const canonicalSlug = localePart?.slug ?? slug;
if (canonicalSlug && canonicalSlug !== slug) {
  return Astro.redirect(`/en/news/${canonicalSlug}`, 301);
}
const articleUrl = `${siteUrl}/en/news/${canonicalSlug}/`;

const publishedAt = article.published_at
  ? new Date(article.published_at).toISOString()
  : undefined;
const modifiedAt = new Date(article.updated_at).toISOString();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: localePart?.title,
  description: localePart?.description,
  datePublished: publishedAt,
  dateModified: modifiedAt,
  url: articleUrl,
  image: article.image_url
    ? [
        `${article.image_url}-640w.webp`,
        `${article.image_url}-1024w.webp`,
      ]
    : undefined,
  author: article.author?.name
    ? {
        "@type": "Person",
        name: article.author.name,
        jobTitle: article.author.position,
      }
    : undefined,
  publisher: {
    "@type": "Organization",
    name: t.meta.siteName,
    url: siteUrl,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};
---

<Layout
  title={`${title} | ${t.meta.siteName}`}
  description={description}
  ogType="article"
  jsonLdExtra={articleJsonLd}
  locale={locale}
>
  <div class="overflow-hidden w-full min-h-screen flex justify-center bg-pure-white">
    <div class="flex w-full relative flex-col items-start min-h-screen">
      <Header
        client:load
        variant="light"
        headerPosition="absolute"
        locale={locale}
        currentPath={Astro.url.pathname}
        hasEnglishTranslation={true}
      />
      <main id="main-content" class="w-full">
        <ArticlePage client:visible article={article} locale={locale} />
      </main>
      <Footer client:visible locale={locale} />
    </div>
  </div>
</Layout>
