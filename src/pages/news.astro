---
/**
 * /news — SSR news listing page (Ukrainian locale).
 *
 * Fetches the first page of published articles from the Go API
 * at request-time so that new articles appear without a rebuild.
 *
 * The NewsPage React component receives `initialArticles` and `initialTotal`
 * as server-provided props, avoiding a client-side loading flash.
 * Subsequent pages / filters are loaded client-side inside NewsPage.
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Footer } from "@/components/layout/Footer";
import { Header } from "@/components/layout/Header";
import { NewsPage } from "@/routes/news/NewsPage";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/i18n";

const locale: Locale = "uk";
const t = getTranslations(locale);

// ─── Server-side data fetch ────────────────────────────────────────────────────

const API_BASE =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:8080";

let initialArticles: unknown[] = [];
let initialTotal = 0;
let initialCategories: unknown[] = [];

try {
  const [articlesRes, categoriesRes] = await Promise.all([
    fetch(
      `${API_BASE}/api/v1/news?locale=${locale}&status=published&limit=12`,
      { headers: { Accept: "application/json" } }
    ),
    fetch(`${API_BASE}/api/v1/news/categories`, {
      headers: { Accept: "application/json" },
    }),
  ]);

  if (articlesRes.ok) {
    const data = (await articlesRes.json()) as {
      articles: unknown[];
      total: number;
    };
    initialArticles = data.articles ?? [];
    initialTotal = data.total ?? 0;

    // Forward cache hints from the Go API.
    const cc = articlesRes.headers.get("Cache-Control");
    if (cc) Astro.response.headers.set("Cache-Control", cc);
  }

  if (categoriesRes.ok) {
    const cats = await categoriesRes.json();
    initialCategories = Array.isArray(cats) ? cats : [];
  }
} catch (err) {
  console.error("[news] SSR fetch failed:", err);
}
---

<Layout
  title={t.meta.newsTitle}
  description={t.meta.newsDescription}
  locale={locale}
>
  <div class="overflow-x-clip w-full min-h-screen flex justify-center bg-slate-50 text-slate-900">
    <div class="flex w-full relative flex-col items-start min-h-screen">
      <Header
        client:load
        headerPosition="absolute"
        locale={locale}
        currentPath={Astro.url.pathname}
      />
      <main id="main-content" class="w-full bg-slate-50 text-slate-900">
        <NewsPage
          client:visible
          locale={locale}
          initialArticles={initialArticles}
          initialTotal={initialTotal}
          initialCategories={initialCategories}
        />
        <Footer client:visible locale={locale} />
      </main>
    </div>
  </div>
</Layout>
