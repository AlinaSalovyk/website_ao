---
/**
 * /preview/news/[slug] — SSR live preview for articles.
 */
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Footer } from "@/components/layout/Footer";
import { Header } from "@/components/layout/Header";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/i18n";
import { LivePreviewClient } from "./_LivePreviewClient";

const localeParam = Astro.url.searchParams.get("locale");
const locale: Locale = localeParam === "en" ? "en" : "uk";
const t = getTranslations(locale);

const { slug } = Astro.params;
const sessionId = Astro.url.searchParams.get("preview_session");

if (!sessionId) {
  return new Response("Missing preview_session", { status: 400 });
}

const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8280";
const ADMIN_PATH = import.meta.env.PUBLIC_ADMIN_PATH ?? "panel";
const ADMIN_BASE = `/admin-${ADMIN_PATH}`;

let article: any = null;

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  let adminTokenVal = "";
  if (cookie.includes("admin_token=")) {
    adminTokenVal = cookie.split("admin_token=")[1].split(";")[0];
  }
  
  const res = await fetch(`${API_BASE}${ADMIN_BASE}/news/drafts/${sessionId}`, {
    headers: { 
      Accept: "application/json",
      Cookie: cookie,
      "X-Admin-Token": adminTokenVal,
      "Authorization": `Bearer ${adminTokenVal}`
    },
  });

  if (!res.ok) {
    if (res.status === 401 || res.status === 403) {
      return new Response("Unauthorized to view preview", { status: 401 });
    }
    console.error(`Preview fetch failed: ${res.status}`);
    article = { type: "article", data: null };
  } else {
    article = await res.json();
  }
} catch (err) {
  console.error("Preview fetch exception:", err);
  article = { type: "article", data: null };
}

const articleData = article?.data || {
  id: "preview",
  status: "draft",
  category_id: "",
  tags: [],
  author: { name: "Preview Author", position: "Role" },
  image_url: "",
  is_pinned: false,
  locales: {
    uk: { title: "Loading Preview...", content: "Connecting to Live Preview...", slug: slug || "preview" },
  }
};

const localePart = articleData.locales?.[locale] ?? articleData.locales?.["uk"];
const title = "[Preview] " + (localePart?.seo_title || localePart?.title || t.meta.newsTitle);
const description = localePart?.seo_description || localePart?.description || t.meta.newsDescription;
---

<Layout
  title={title}
  description={description}
  ogImage={articleData.image_url ? `${articleData.image_url}-1024w.webp` : undefined}
  noIndex={true}
>
  <div class="overflow-x-clip w-full min-h-screen flex justify-center bg-slate-50 text-slate-900">
    <div class="flex w-full relative flex-col items-start min-h-screen">
      <Header
        client:load
        headerPosition="absolute"
        locale={locale}
        currentPath={Astro.url.pathname + Astro.url.search}
      />
      <main id="main-content" class="w-full bg-slate-50 text-slate-900">
        <LivePreviewClient
          client:load
          sessionId={sessionId}
          type="article"
          initialData={articleData}
          locale={locale}
        />
        <Footer client:visible locale={locale} />
      </main>
    </div>
  </div>
</Layout>
