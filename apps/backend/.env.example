# ─── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Vector DB ────────────────────────────────────────────────────────────────
# For local Docker: use "localhost"
# For Qdrant Cloud: use "your-cluster-id.europe-west3-0.gcp.cloud.qdrant.io"
QDRANT_URL=localhost
QDRANT_API_KEY=

# ─── Analytics DB ─────────────────────────────────────────────────────────────
DB_PATH=./data/analytics.db

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
# Legacy admin API token disabled by default (set true to enable)
LEGACY_ADMIN_TOKEN_ENABLED=false
ADMIN_TOKEN=

# BOOTSTRAP ONLY: Emails permitted to initialize the first super_admin on empty database.
# Deprecated alias: ADMIN_ALLOWED_EMAILS
BOOTSTRAP_SUPER_ADMIN_EMAILS=
ADMIN_ALLOWED_EMAILS=

# Max chat requests per 5 minutes per IP (default: 10)
RATE_LIMIT_PER_MIN=10

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to "debug" for verbose output (default: info)
LOG_LEVEL=info

# ─── Phase 2: Google OAuth ────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8080/admin/auth/callback

# JWT secret for admin session tokens (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of allowed Google emails for admin access
# Leave empty to allow any authenticated Google user
ADMIN_ALLOWED_EMAILS=

# ─── Phase 3: Upstash Redis (Caching) ────────────────────────────────────────
# Get from: console.upstash.com → Redis → REST API
# Leave empty to disable caching (system works fine without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Phase 3: Feature Flags ──────────────────────────────────────────────────
# Enable Gemini-based reranking of search results (adds ~200ms latency)
ENABLE_RERANKING=false

# OpenRouter API Key
OPENROUTER_API_KEY=

# Self-hosted LibreTranslate Service URL for Article Translation (UK -> EN)
LIBRETRANSLATE_URL=

# ─── Admin Invitations & RBAC Configuration ────────────────────────────────
# Required: Base URL used to construct public invitation links (e.g. http://localhost:4321)
ADMIN_PUBLIC_BASE_URL=http://localhost:4321

# Required: Invitation expiration duration (e.g. 48h, 72h)
ADMIN_INVITATION_TTL=48h

# ─── Production / Development SMTP Configuration ──────────────────────────────
# Required: Mailer driver (smtp | noop)
MAILER_DRIVER=smtp

# Required: SMTP Hostname
#   - Local Sandbox (Mailpit): localhost (or mailpit when connecting between containers)
#   - Production (Gmail): smtp.gmail.com
# IMPORTANT: Ensure docker-compose.yml does NOT hardcode SMTP_HOST under services.backend.environment
# so that this value can take effect dynamically.
SMTP_HOST=smtp.gmail.com

# Required: SMTP Port
#   - Mailpit: 1025
#   - STARTTLS (Gmail / Office365): 587
#   - SSL/TLS: 465
SMTP_PORT=587

# Required: Transport encryption mode (none | starttls | tls)
#   - Mailpit: none
#   - Gmail STARTTLS: starttls
SMTP_SECURITY=starttls

# Required: Authentication mode (none | plain | login)
#   - Mailpit: none
#   - Gmail: plain
SMTP_AUTH_MODE=plain

# Required if SMTP_AUTH_MODE=plain: SMTP Credentials
# For Gmail: Must use a 16-character App Password generated via Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USERNAME=admin@domain.com
SMTP_PASSWORD="your-16-char-app-password"

# Required: Sender Email Address and Display Name
SMTP_FROM_EMAIL=admin@domain.com
SMTP_FROM_NAME="Адміністративна панель Острозька академія"

# Optional: Connection Timeout (default: 10s)
SMTP_TIMEOUT=10s




